+    def test_password_reset_accepts_a_valid_database_token(self):
+        token = "offline-reset-regression-token"
+        with self.session_factory() as db:
+            db.add(
+                PasswordResetToken(
+                    user_id=1,
+                    token=token,
+                    expires_at=datetime.now(timezone.utc) + timedelta(hours=1),
+                )
+            )
+            db.commit()
+
+        with (
+            patch("app.routers.auth.hash_password", return_value="new-password-hash"),
+            patch("app.routers.auth.log_action"),
+            self._client() as client,
+        ):
+            response = client.post(
+                "/auth/reset-password",
+                json={"token": token, "new_password": "new-password"},
+            )
+
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertEqual(response.json()["detail"], "Password has been reset successfully")
+
+        with self.session_factory() as db:
+            db.add(
+                PasswordResetToken(
+                    user_id=1,
+                    token="offline-expired-reset-token",
+                    expires_at=datetime.now(timezone.utc) - timedelta(minutes=1),
+                )
+            )
+            db.commit()
+
+        with self._client() as client:
+            expired = client.post(
+                "/auth/reset-password",
+                json={"token": "offline-expired-reset-token", "new_password": "new-password"},
+            )
+        self.assertEqual(expired.status_code, 400, expired.text)
+
 
 if __name__ == "__main__":
     unittest.main()
